{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "jsx": "react-jsx", "noEmit": true, "skipLibCheck": true,
    "resolveJsonModule": true, "esModuleInterop": true, "isolatedModules": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["node"]
  },
  "include": ["server", "client", "scripts/*.ts", "tests", "e2e", "*.ts"]
}
